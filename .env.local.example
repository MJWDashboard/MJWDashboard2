NEXT_PUBLIC_SUPABASE_URL=https://eaxyxsrsljdonkravpoj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-key-here

# Server-only. Supabase dashboard -> Project Settings -> API -> service_role.
# Used by the 04:30 digest cron (bypasses RLS to read across the whole
# account). Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here

# Shared secret the digest cron checks on its Authorization header. Set the
# same value in Vercel's Cron Job settings for this route.
CRON_SECRET=choose-a-random-string

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). Add {your-domain}/api/google/callback (and
# http://localhost:3000/api/google/callback for local dev) as an authorized
# redirect URI, and enable the Google Calendar API for the project. See
# README.md for the full walkthrough.
GOOGLE_CLIENT_ID=paste-your-google-oauth-client-id-here
GOOGLE_CLIENT_SECRET=paste-your-google-oauth-client-secret-here

# Optional. console.anthropic.com -> API keys. Turns on AI-assisted
# natural-language parsing in Quick Capture (lib/captureParserAI.ts). Quick
# Capture works without this — it falls back to the rule-based parser in
# lib/captureParser.ts.
ANTHROPIC_API_KEY=paste-your-anthropic-api-key-here
